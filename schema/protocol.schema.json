{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaniguan/lab-rehearsal/schema/protocol.schema.json",
  "title": "LabRehearsalProtocol",
  "description": "Strict default-deny schema for liquid-handling and thermal/state micro-step protocols.",
  "type": "array",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "const": "pick_up_tip" },
          "loc": {
            "type": "string",
            "pattern": "^tiprack(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])$"
          },
          "channels": {
            "type": "integer",
            "enum": [1, 8]
          },
          "pipette": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": { "const": "drop_tip" },
          "allow_wet_drop": { "type": "boolean" },
          "channels": {
            "type": "integer",
            "enum": [1, 8]
          },
          "pipette": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc", "vol"],
        "properties": {
          "op": { "const": "aspirate" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|trash:1)$"
          },
          "vol": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "channels": {
            "type": "integer",
            "enum": [1, 8]
          },
          "pipette": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc", "vol"],
        "properties": {
          "op": { "const": "dispense" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|trash:1)$"
          },
          "vol": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "air_dispense": { "type": "boolean" },
          "channels": {
            "type": "integer",
            "enum": [1, 8]
          },
          "pipette": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc", "vol"],
        "properties": {
          "op": { "const": "mix" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|trash:1)$"
          },
          "vol": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "channels": {
            "type": "integer",
            "enum": [1, 8]
          },
          "pipette": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc", "temp_c", "duration_s"],
        "properties": {
          "op": { "const": "incubate" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|plate(?:_[A-Za-z0-9_]+)?)$"
          },
          "temp_c": {
            "type": "number"
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc"],
        "properties": {
          "op": { "const": "seal" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|plate(?:_[A-Za-z0-9_]+)?)$"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": ["op", "loc"],
        "properties": {
          "op": { "const": "thaw" },
          "loc": {
            "type": "string",
            "pattern": "^(plate(?:_[A-Za-z0-9_]+)?:[A-H](1[0-2]|[1-9])|res:(1[0-2]|[1-9])|res_[A-Za-z0-9_]+:[A-H](1[0-2]|[1-9])|plate(?:_[A-Za-z0-9_]+)?)$"
          }
        },
        "additionalProperties": false
      }
    ]
  }
}
